{
  "version": 2,
  "builds": [
    { "src": "api/*.js", "use": "@vercel/node" },
    { "src": "*.html",   "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/chat",  "dest": "/api/chat.js" },
    { "src": "/",          "dest": "/index.html" },
    { "src": "/demo",      "dest": "/demo.html" },
    { "src": "/demo.html", "dest": "/demo.html" }
  ]
}
